hostname: ${hostname}
fqdn: ${hostname}
manage_etc_hosts: true

users:
  - name: ${admin_user}
    groups: [sudo]
    shell: /bin/bash
    lock_passwd: true
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    ssh_authorized_keys:
      - ${admin_ssh_key}

  - name: ${ansible_user}
    groups: [sudo]
    shell: /bin/bash
    lock_passwd: true
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    ssh_authorized_keys:
      - ${ansible_ssh_key}

ssh_pwauth: false

disable_root: true

runcmd:
  - passwd -l root
